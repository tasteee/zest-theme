  "semanticTokenColors": {
    "variable": { "foreground": "#80C098" },
    "variable.readonly": { "foreground": "#80C098" },
    "variable.defaultLibrary": { "foreground": "#80C098" },
    "parameter": { "foreground": "#68A880", "fontStyle": "italic" },
    "function": { "foreground": "#98D0A8", "fontStyle": "bold" },
    "function.declaration": { "foreground": "#B8E8C8" },
    "function.defaultLibrary": { "foreground": "#98D0A8", "fontStyle": "bold" },
    "method": { "foreground": "#98D0A8", "fontStyle": "bold" },
    "method.declaration": { "foreground": "#B8E8C8" },
    "class": { "foreground": "#C8B0E0" },
    "class.declaration": { "foreground": "#C8B0E0" },
    "interface": { "foreground": "#C8B0E0" },
    "interface.declaration": { "foreground": "#C8B0E0" },
    "type": { "foreground": "#C8B0E0" },
    "type.declaration": { "foreground": "#C8B0E0" },
    "enum": { "foreground": "#C8B0E0" },
    "enum.declaration": { "foreground": "#C8B0E0" },
    "enumMember": { "foreground": "#C8A878" },
    "property": { "foreground": "#C8A878" },
    "property.declaration": { "foreground": "#C8A878" },
    "namespace": { "foreground": "#8878A8", "fontStyle": "italic" },
    "typeParameter": { "foreground": "#8878A8", "fontStyle": "italic" },
    "decorator": { "foreground": "#D078A8", "fontStyle": "bold italic" },
    "keyword": { "foreground": "#A898C8" },
    "string": { "foreground": "#686D68" },
    "number": { "foreground": "#A89068" },
    "comment": { "foreground": "#505550", "fontStyle": "italic" },
    "operator": { "foreground": "#585D58" },
    "macro": { "foreground": "#D078A8", "fontStyle": "bold italic" },
    "label": { "foreground": "#A898C8" },
    "regexp": { "foreground": "#808580" }
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#505550", "fontStyle": "italic" }
    },
    {
      "name": "JSDoc tags",
      "scope": [
        "storage.type.class.jsdoc",
        "punctuation.definition.block.tag.jsdoc"
      ],
      "settings": { "foreground": "#8878A8", "fontStyle": "italic" }
    },
    {
      "name": "JSDoc param names",
      "scope": ["variable.other.jsdoc"],
      "settings": { "foreground": "#68A880", "fontStyle": "italic" }
    },
    {
      "name": "JSDoc types",
      "scope": ["entity.name.type.instance.jsdoc"],
      "settings": { "foreground": "#C8B0E0", "fontStyle": "italic" }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "#A898C8" }
    },
    {
      "name": "Keyword operators (semantic)",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.expression.typeof",
        "keyword.operator.expression.instanceof",
        "keyword.operator.expression.void",
        "keyword.operator.expression.in",
        "keyword.operator.expression.of",
        "keyword.operator.expression.as",
        "keyword.operator.expression.is",
        "keyword.operator.expression.keyof",
        "keyword.operator.expression.satisfies"
      ],
      "settings": { "foreground": "#A898C8" }
    },
    {
      "name": "this / super",
      "scope": ["variable.language.this", "variable.language.super"],
      "settings": { "foreground": "#A898C8", "fontStyle": "italic" }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.ternary",
        "keyword.operator.optional",
        "keyword.operator.spread",
        "keyword.operator.rest",
        "keyword.operator.type",
        "keyword.operator.optional",
        "storage.type.function.arrow"
      ],
      "settings": { "foreground": "#585D58" }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.dict",
        "punctuation.definition.dictionary",
        "punctuation.definition.object",
        "punctuation.definition.array",
        "punctuation.section.embedded",
        "punctuation.definition.tag",
        "punctuation.definition.template-expression",
        "meta.brace.curly",
        "meta.brace.square",
        "meta.brace.round"
      ],
      "settings": { "foreground": "#585D58" }
    },
    {
      "name": "Type names",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.other.inherited-class",
        "support.type",
        "entity.name.type.alias",
        "entity.name.type.enum",
        "entity.name.type.module",
        "support.type.primitive",
        "keyword.type",
        "entity.name.type.predefined",
        "support.class"
      ],
      "settings": { "foreground": "#C8B0E0" }
    },
    {
      "name": "Generic type parameters",
      "scope": [
        "meta.type.parameters entity.name.type",
        "entity.name.type.type-parameter"
      ],
      "settings": { "foreground": "#8878A8", "fontStyle": "italic" }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": { "foreground": "#D078A8", "fontStyle": "bold italic" }
    },
    {
      "name": "Function definitions",
      "scope": ["entity.name.function", "meta.function entity.name.function"],
      "settings": { "foreground": "#B8E8C8" }
    },
    {
      "name": "Function calls",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.generic entity.name.function"
      ],
      "settings": { "foreground": "#98D0A8", "fontStyle": "bold" }
    },
    {
      "name": "Support functions",
      "scope": ["support.function", "support.function.builtin"],
      "settings": { "foreground": "#98D0A8", "fontStyle": "bold" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#80C098" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#68A880", "fontStyle": "italic" }
    },
    {
      "name": "Properties and object keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "meta.object.member",
        "meta.object-literal.key string"
      ],
      "settings": { "foreground": "#C8A878" }
    },
    {
      "name": "Constants",
      "scope": ["variable.other.constant", "support.constant"],
      "settings": { "foreground": "#E0C898" }
    },
    {
      "name": "Boolean / null / undefined",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.nan"
      ],
      "settings": { "foreground": "#787D78" }
    },
    {
      "name": "Enum members",
      "scope": ["variable.other.enummember"],
      "settings": { "foreground": "#C8A878" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#686D68" }
    },
    {
      "name": "String escape sequences",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#808580" }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp", "constant.regexp"],
      "settings": { "foreground": "#808580" }
    },
    {
      "name": "Regex structural characters",
      "scope": [
        "keyword.operator.quantifier.regexp",
        "keyword.operator.or.regexp",
        "punctuation.definition.group.regexp",
        "keyword.operator.negation.regexp"
      ],
      "settings": { "foreground": "#A898C8" }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#A89068" }
    },
    {
      "name": "JSX / HTML intrinsic elements",
      "scope": [
        "entity.name.tag.html.tsx",
        "entity.name.tag.html.jsx",
        "entity.name.tag"
      ],
      "settings": { "foreground": "#A898C8" }
    },
    {
      "name": "JSX Component names",
      "scope": [
        "support.class.component",
        "entity.name.tag.tsx",
        "entity.name.tag.jsx"
      ],
      "settings": { "foreground": "#C8B0E0" }
    },
    {
      "name": "HTML / JSX attribute names",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#C8A878" }
    },
    {
      "name": "HTML attribute values",
      "scope": ["string.quoted.double.html", "string.quoted.single.html"],
      "settings": { "foreground": "#686D68" }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": { "foreground": "#98D0A8" }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss"
      ],
      "settings": { "foreground": "#C8A878" }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value",
        "constant.other.color.rgb-value"
      ],
      "settings": { "foreground": "#C8B0E0" }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.key.json string"
      ],
      "settings": { "foreground": "#C8A878" }
    },
    {
      "name": "JSON values",
      "scope": ["meta.structure.dictionary.value string.json"],
      "settings": { "foreground": "#686D68" }
    },
    {
      "name": "YAML keys",
      "scope": ["entity.name.tag.yaml"],
      "settings": { "foreground": "#C8A878" }
    },
    {
      "name": "YAML values",
      "scope": ["string.unquoted.yaml", "string.quoted.yaml"],
      "settings": { "foreground": "#686D68" }
    },
    {
      "name": "TOML keys",
      "scope": ["keyword.key.toml", "support.type.property-name.toml"],
      "settings": { "foreground": "#C8A878" }
    },
    {
      "name": "TOML tables",
      "scope": ["entity.name.table.toml"],
      "settings": { "foreground": "#A898C8" }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": { "foreground": "#FAFAFA", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#FAFAFA", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#D0D0D0", "fontStyle": "italic" }
    },
    {
      "name": "Markdown code inline",
      "scope": ["markup.inline.raw"],
      "settings": { "foreground": "#98D0A8" }
    },
    {
      "name": "Markdown link text",
      "scope": ["string.other.link"],
      "settings": { "foreground": "#C8B0E0" }
    },
    {
      "name": "Markdown link URL",
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#A898C8", "fontStyle": "underline" }
    },
    {
      "name": "Markdown blockquote",
      "scope": ["markup.quote", "punctuation.definition.quote"],
      "settings": { "foreground": "#686D68", "fontStyle": "italic" }
    },
    {
      "name": "Markdown list punctuation",
      "scope": ["beginning.punctuation.definition.list"],
      "settings": { "foreground": "#A898C8" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid.illegal"],
      "settings": { "foreground": "#D078A8", "fontStyle": "strikethrough" }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#585D58", "fontStyle": "strikethrough" }
    }
  ]
}
